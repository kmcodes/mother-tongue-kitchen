# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Sarvam speech-to-text
SARVAM_API_KEY=

# Neon Postgres
DATABASE_URL=

# Vercel Blob (private audio storage)
BLOB_READ_WRITE_TOKEN=

# LLM used to structure transcripts into title, ingredients, steps
AI_GATEWAY_API_KEY=

# WhatsApp Business (OTP login)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=

# Signs login sessions. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Dev login (never set in production)
AUTH_MODE=

# Structuring model on the AI Gateway, for example anthropic/claude-sonnet-5.5
STRUCTURE_MODEL=

# Shared secret Sarvam sends in X-SARVAM-JOB-CALLBACK-TOKEN
SARVAM_WEBHOOK_TOKEN=

# Public base URL of the deployed app, for webhook callbacks
APP_BASE_URL=

# Protects /api/cron/sweep
CRON_SECRET=
